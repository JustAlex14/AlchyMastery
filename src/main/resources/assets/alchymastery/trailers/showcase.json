  "texts": [
    {
      "at": 40,
      "ticks": 110,
      "text": "AlchyMastery",
      "style": "title",
      "color": "#B98CFF"
    },
    {
      "at": 200,
      "ticks": 110,
      "text": "They called me a dreamer. This hall is what the dreamer built.",
      "style": "caption"
    },
    {
      "at": 390,
      "ticks": 120,
      "text": "I did not want a fire. I wanted a wound in the world, and a room to keep it open.",
      "style": "caption"
    },
    {
      "at": 650,
      "ticks": 120,
      "text": "Ore goes in. Something purer comes out. Nobody has to dig anymore.",
      "style": "caption"
    },
    {
      "at": 920,
      "ticks": 120,
      "text": "Iron, gold, bone. To these walls it is all the same clay.",
      "style": "caption"
    },
    {
      "at": 1220,
      "ticks": 120,
      "text": "The thing in the cauldron works without sleep. I never asked where it came from.",
      "style": "caption"
    },
    {
      "at": 1810,
      "ticks": 120,
      "text": "Four rooms folded into one heartbeat. Distance was only a habit.",
      "style": "caption"
    },
    {
      "at": 2180,
      "ticks": 120,
      "text": "AlchyMastery",
      "style": "title",
      "color": "#B98CFF"
    },
    {
      "at": 2205,
      "ticks": 95,
      "text": "Past the last fold, something is still calling.",
      "style": "subtitle"
    }
  ],
